{
  "manifest_version": 3,
  "name": "Motelli WhatsApp",
  "version": "1.2.0",
  "description": "Envia sozinho, pelo WhatsApp Web, as mensagens de cotação do sistema Motelli aos fornecedores (um a um, marcando como enviado).",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Motelli WhatsApp",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://www.brasarestaurante.com.br/*",
    "https://brasarestaurante.com.br/*",
    "https://*.motelli.com.br/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.brasarestaurante.com.br/*",
        "https://brasarestaurante.com.br/*",
        "https://*.motelli.com.br/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content-sistema.js"
      ]
    }
  ]
}
