# Variáveis de ambiente do sistema (COD-005).
# Copie para .env.local (no PC) ou cadastre na Vercel (Settings → Environment
# Variables). NUNCA coloque valor real neste arquivo: ele vai pro git, que é público.
# A URL e a chave pública (anon) do Supabase ficam em src/lib/supabase/config.ts.

# --- Obrigatórias ------------------------------------------------------------
# Chave administrativa do Supabase (passa por cima das regras do banco; só no servidor).
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta com o Postgres, usada por scripts/migrate.mjs pra aplicar as migrations.
DATABASE_URL=
# Senha que as rotinas agendadas (Vercel Cron) mandam no cabeçalho Authorization.
CRON_SECRET=
# Endereço público do sistema (links de WhatsApp, QR, apps). Sem ela, usa o do Brasa.
# Ex.: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# --- Pix online (opcional; sem elas o Pix do caixa/PDV/app fica desligado) ---
# Banco do Pix: sicoob ou sicredi. As demais seguem o padrão PIX_<BANCO>_<NOME>.
PIX_BANCO=
PIX_SICOOB_CLIENT_ID=
PIX_SICOOB_CLIENT_SECRET=
PIX_SICOOB_CHAVE=
# Certificado e chave do e-CNPJ em base64 (produção).
PIX_SICOOB_CERT_B64=
PIX_SICOOB_KEY_B64=
PIX_SICOOB_CA_B64=
# Opcionais: ambiente (producao/sandbox), escopos e endereços próprios da API.
PIX_SICOOB_AMBIENTE=
PIX_SICOOB_ESCOPOS=
PIX_SICOOB_URL_API=
PIX_SICOOB_URL_TOKEN=
# Só pra testar no ambiente de testes do Sicoob.
PIX_SICOOB_TOKEN_SANDBOX=
# Se usar Sicredi: as mesmas com PIX_SICREDI_ (+ PIX_SICREDI_COB_VERSAO, opcional).

# --- WhatsApp pela API da Meta (opcional) ------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
# Texto qualquer combinado com a Meta pra confirmar o webhook.
WHATSAPP_VERIFY_TOKEN=
# Identificadores públicos do app da Meta (botão "Conectar WhatsApp").
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_WPP_CONFIG_ID=

# --- Mapas (opcional; delivery: distância, taxa por área) --------------------
# Chave do servidor (cálculo de rota).
GOOGLE_MAPS_API_KEY=
# Chave do navegador (mapa na tela); prenda ao domínio no Google Cloud.
GOOGLE_MAPS_BROWSER_KEY=

# --- Avisos no celular dos apps (opcional) -----------------------------------
# Conta de serviço do Firebase (JSON inteiro em base64).
FIREBASE_SERVICE_ACCOUNT_B64=

# --- TV do rodízio (opcional) ------------------------------------------------
# Chave do endereço /tv?chave= que abre sem login.
RODIZIO_TV_CHAVE=

# --- Só no PC de desenvolvimento (opcional) ----------------------------------
# Força as cores da marca sem depender do cadastro da empresa.
MARCA_PRIMARIA_DEV=
MARCA_ESCURO_DEV=
MARCA_SOBRE_ESCURO_DEV=
